@echo off
REM Sao chep file nay thanh mail.local.cmd va dien thong tin Gmail (App Password).
REM Khong commit mail.local.cmd — file da co trong .gitignore.

set MAIL_ENABLED=true
set MAIL_HOST=smtp.gmail.com
set MAIL_PORT=587
set MAIL_USERNAME=your@gmail.com
set MAIL_PASSWORD=your-16-char-app-password
set MAIL_FROM=PhongG Cinema ^<your@gmail.com^>

set APP_FRONTEND_URL=http://localhost:5173

REM Gemini AI — key AIza... tu https://aistudio.google.com/apikey
set GEMINI_ENABLED=true
set GEMINI_API_KEY=your-aiza-key-here

REM AI soan noi dung phim
set MOVIE_AI_ENABLED=true
set SEARXNG_URL=http://127.0.0.1:8888
